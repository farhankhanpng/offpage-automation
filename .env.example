# IA Spaces Off-Page SEO Automation - environment variables
# Copy this file to .env and fill in what you need. Every value is optional:
# defaults come from config/settings.yaml. Real environment variables (for example
# GitHub Actions secrets) always win over values in .env.

# --- Google Sheets ---
# Path to the service account JSON key (relative to offpage-automation/ or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Spreadsheet name (must be shared with the service account email as Editor)
GOOGLE_SHEET_NAME=IA Spaces - Off-Page SEO Master
# Recommended: the ID from the Sheet URL (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
# Set to true to make the run fail when Sheets can't be reached (GitHub Actions does this)
REQUIRE_SHEETS=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Polite crawling ---
REQUEST_TIMEOUT_SECONDS=15
REQUEST_DELAY_SECONDS=3
MAX_RETRIES=2
USER_AGENT=IASpacesSEOBot/1.1 (+https://iaspaces.co; info@iaspaces.co)

# Alerts: when a scheduled GitHub Actions run fails (exit code 1 or 2), GitHub emails the
# repository owner automatically. No email settings are needed here.
