# IA Spaces Off-Page SEO Automation Environment Variables
# Copy this file to .env and fill in your values

# Google Sheets Configuration
# Path to your Google Service Account JSON key (relative to offpage-automation/ or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# Name or ID of your target Google Spreadsheet (must be shared with service account email)
GOOGLE_SHEET_NAME=IA Spaces - Off-Page SEO Automation

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Crawler Configuration (Polite Crawling)
REQUEST_TIMEOUT_SECONDS=15
REQUEST_DELAY_SECONDS=2
USER_AGENT=IASpaces-SEO-Bot/1.0 (+https://iaspaces.co/bot-info; contact: info@iaspaces.co)

# Email Notifications (Optional for internal admin alerts, NEVER sent to external targets)
ENABLE_ADMIN_ALERTS=false
ADMIN_EMAIL=
