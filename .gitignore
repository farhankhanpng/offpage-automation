# Secrets and credentials
# ("secrets/*" rather than "secrets/" so the .gitkeep exception below can work)
secrets/*
!secrets/.gitkeep
*.json
.env
.env.local

# Logs and run artifacts
logs/
*.log

# Dry runs never belong in git
data/dry_run_cache/
reports/dry-run/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Temporary data
data/cache/
data/*.tmp
